apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: demo-jobs
  namespace: argocd
spec:
  sourceRepos:
    - https://github.com/theanh-05-uit/gitops-platform-config.git
  destinations:
    - server: https://kubernetes.default.svc
      namespace: workloads
  clusterResourceWhitelist: []
  namespaceResourceWhitelist:
    - group: apps
      kind: Deployment
    - group: batch
      kind: CronJob
    - group: networking.k8s.io
      kind: NetworkPolicy
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: demo-jobs
  namespace: argocd
spec:
  project: demo-jobs
  source:
    repoURL: https://github.com/theanh-05-uit/gitops-platform-config.git
    targetRevision: main
    path: apps/demo-jobs
    helm:
      valuesObject:
        enabled: true
        imageDigest: "<approved-single-image-digest>"
        placementRegion: "<approved-placement-label>"
  destination:
    server: https://kubernetes.default.svc
    namespace: workloads
  syncPolicy:
    automated:
      enabled: false
